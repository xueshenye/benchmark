# Copy to `.env` and fill in real values. Load with `harbor run --env-file .env`.
# `.env` is git-ignored (contains secrets); `.env.example` is the template.

# ---------------------------------------------------------------------------
# Execution provider: Novita sandbox (harbor run -e novita)
#   1. Sign up at https://novita.ai
#   2. Key Management -> create an API key (starts with `sk_`)
#      https://novita.ai/console/user-profile/api-key
#   3. Make sure the account has balance — sandbox + LLM calls are billed
#      against it (an empty account returns 403 NOT_ENOUGH_BALANCE).
# ---------------------------------------------------------------------------
NOVITA_API_KEY=sk_...

# Optional overrides (defaults are fine):
# NOVITA_DOMAIN=us-phx-1.sandbox.novita.ai
# NOVITA_API_URL=https://api.us-phx-1.sandbox.novita.ai

# ---------------------------------------------------------------------------
# Simulated user LLM — the "user" that reacts to the agent's actual output.
# Runs through Novita's OpenAI-compatible endpoint (same key as above).
#
# MODEL NAME GOTCHA: USER_LLM_MODEL must carry a LiteLLM-recognized provider
# prefix. Novita's /openai serves the model under id "moonshotai/kimi-k3";
# use the `openai/` prefix so LiteLLM routes via the OpenAI-compatible client
# and sends the id verbatim. A bare "moonshotai/kimi-k3" CRASHES LiteLLM's
# provider resolution ("moonshotai" is not a known provider).
# ---------------------------------------------------------------------------
USER_LLM_MODEL=openai/moonshotai/kimi-k3
USER_LLM_API_BASE=https://api.novita.ai/openai
USER_LLM_API_KEY=sk_...

# ---------------------------------------------------------------------------
# Agent claude-code auth — the coding agent that does the work. claude-code
# inside the Novita sandbox needs a working Anthropic-compatible backend;
# without it the CLI fails with "Not logged in". The host Claude setup uses
# DeepSeek's /anthropic proxy — mirror those two vars here. The model itself is
# passed on the CLI (-m deepseek-v4-flash, NOT a claude-* name).
# ---------------------------------------------------------------------------
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_AUTH_TOKEN=sk-...
